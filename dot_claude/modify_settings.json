{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code が /config などで settings.json を書き換えるため、ファイル全体ではなく必要なキーだけをマージする */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $settings = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $permissions := get $settings "permissions" | default dict -}}
{{- $deny := get $permissions "deny" | default list -}}
{{- range list "Read(//**/.env)" "Read(//**/.env.*)" -}}
{{-   if not (has . $deny) -}}
{{-     $deny = append $deny . -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $permissions "deny" $deny -}}
{{- $_ := set $settings "permissions" $permissions -}}
{{ toPrettyJson $settings }}
